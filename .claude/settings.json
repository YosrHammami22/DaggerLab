{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-kotlin.sh",
            "timeout": 30,
            "statusMessage": "Formatting Kotlin with ktlint..."
          }
        ]
      }
    ]
  }
}